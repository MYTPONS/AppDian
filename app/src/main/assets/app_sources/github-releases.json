        "listRule": "json:$.assets",
        "itemRules": {
          "name": "json:name",
          "downloadName": "json:name",
          "downloadUrl": "json:browser_download_url",
          "downloadSize": "json:size",
          "icon": "text:https://github.githubassets.com/favicons/favicon.svg",
          "detailUrl": "{{sourceUrl}}/repos/{{full_name}}/releases/latest",
          "extras": {
            "full_name": "text:M66B/NetGuard"
          }
        }
      }
    },
    {
      "title": "Termux 最新发布",
      "category": "dev",
      "section": {
        "url": "/repos/termux/termux-app/releases/latest",
        "listRule": "json:$.assets",
        "itemRules": {
          "name": "json:name",
          "downloadName": "json:name",
          "downloadUrl": "json:browser_download_url",
          "downloadSize": "json:size",
          "icon": "text:https://github.githubassets.com/favicons/favicon.svg",
          "detailUrl": "{{sourceUrl}}/repos/{{full_name}}/releases/latest",
          "extras": {
            "full_name": "text:termux/termux-app"
          }
        }
      }
    }
  ]
}