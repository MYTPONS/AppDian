{
  "sourceName": "GitHub Releases",
  "sourceUrl": "https://api.github.com",
  "sourceVersion": "1.1.0",
  "sourceIcon": "https://github.githubassets.com/favicons/favicon.svg",
  "userAgent": "AppDian/0.1 (AppStore-Source-Engine)",
  "search": {
    "url": "/search/repositories?q={{key}}+topic:android&sort=stars&per_page=15",
    "listRule": "json:$.items",
    "itemRules": {
      "name": "json:full_name",
      "summary": "json:description",
      "icon": "json:owner.avatar_url",
      "extras": {
        "full_name": "json:full_name"
      },
      "detailUrl": "{{sourceUrl}}/repos/{{full_name}}/releases/latest"
    }
  },
  "detail": {
    "url": "/repos/{{full_name}}/releases/latest",
    "itemRules": {
      "name": "json:$.assets[0].name",
      "version": "json:$.tag_name",
      "summary": "json:$.name",
      "downloadName": "json:$.assets[0].name",
      "downloadUrl": "json:$.assets[0].browser_download_url",
      "downloadSize": "json:$.assets[0].size",
      "icon": "text:https://github.githubassets.com/favicons/favicon.svg"
    }
  },
  "discovery": [
    {
